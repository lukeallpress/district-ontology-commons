{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sop-to-ontology/schema/role.schema.json",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["where", "kind", "learned"],
      "properties": {
        "where": { "type": "string", "minLength": 3, "description": "Where this was learned, specific enough to find again. Never a person's name." },
        "kind": { "enum": ["code", "job", "data", "document", "web", "meeting", "conversation", "email", "observation"] },
        "learned": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "link": { "type": "string", "minLength": 3 },
        "supports": { "type": "array", "items": { "type": "string" } },
        "recheck_by": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  },
  "title": "Role record",
  "description": "What a role is for, what it owns, what it decides, what it does on a cadence, and how to work with it. A role, never a person: the holder changes, the record stays.",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "name", "status", "source", "purpose", "owns", "decides", "cadences", "how_to_work_with", "visibility"],
  "properties": {
    "visibility": { "enum": ["public", "staff", "internal", "restricted"] },
    "key": { "type": "string", "pattern": "^role:[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 3, "maxLength": 120 },
    "status": { "type": "string", "enum": ["drafted", "verified", "retired"] },
    "source": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "last_verified": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "classification": {
      "type": "string",
      "description": "The Ed-Fi Unifying Data Model StaffClassification descriptor value this role falls under, verbatim (e.g. 'School Counselor', 'School Administrator', 'LEA Administrator'). For comparison across organizations; the key carries the local precision."
    },
    "titles": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 },
      "description": "The local directory job titles that map to this role, as aliases. Routing matches titles here, never free text in processes."
    },
    "reports_to": { "type": ["string", "null"], "description": "A role key or a title" },
    "purpose": { "type": "string", "minLength": 10 },
    "owns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "processes": { "type": "array", "items": { "type": "string", "pattern": "^process:" } },
        "systems": { "type": "array", "items": { "type": "string", "pattern": "^[a-z-]+:[a-z0-9-]+$" } },
        "repos": { "type": "array", "items": { "type": "string" } },
        "other": { "type": "array", "items": { "type": "string" } }
      }
    },
    "decides": { "type": "array", "items": { "type": "string", "minLength": 5 }, "description": "Decision rights, in plain words" },
    "does_not_decide": { "type": "array", "items": { "type": "string", "minLength": 5 } },
    "cadences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["what", "when"],
        "properties": {
          "what": { "type": "string" },
          "when": { "type": "string" },
          "with": { "type": "string", "description": "Roles, never names" },
          "evidence": { "type": ["string", "null"] }
        }
      }
    },
    "standing_rules": { "type": "array", "items": { "type": "string", "minLength": 5 }, "description": "Rules the role holds everyone to; each should also exist as a decision record" },
    "how_to_work_with": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ask"],
      "properties": {
        "ask": { "type": "string", "description": "How to bring a question or a request" },
        "approve": { "type": "string", "description": "What needs this role's yes, and what form the yes takes" },
        "never": { "type": "array", "items": { "type": "string" } },
        "prefers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "handoff": { "type": "string", "description": "What a successor would need on day one" },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "findings": { "type": "array", "items": { "type": "string", "minLength": 10 } }
  }
}
