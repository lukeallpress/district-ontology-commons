{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sop-to-ontology/schema/decision.schema.json",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["where", "kind", "learned"],
      "properties": {
        "where": { "type": "string", "minLength": 3, "description": "Where this was learned, specific enough to find again. Never a person's name." },
        "kind": { "enum": ["code", "job", "data", "document", "web", "meeting", "conversation", "email", "observation"] },
        "learned": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "link": { "type": "string", "minLength": 3 },
        "supports": { "type": "array", "items": { "type": "string" } },
        "recheck_by": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  },
  "title": "Standing decision",
  "description": "A decision people still obey: what was decided, by which role, when, why, and what would reopen it. The reason matters more than the ruling; a successor who knows the reason can tell when it no longer applies.",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "title", "status", "decided_on", "decided_by", "decision", "reason", "source", "visibility"],
  "properties": {
    "visibility": { "enum": ["public", "staff", "internal", "restricted"] },
    "key": { "type": "string", "pattern": "^decision:[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 5, "maxLength": 140 },
    "status": { "type": "string", "enum": ["standing", "superseded", "proposed", "retired"] },
    "decided_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$", "description": "A month or a day; quoted in YAML" },
    "decided_by": {
      "type": "string",
      "pattern": "^role:[a-z0-9]+(-[a-z0-9]+)*( \\(not yet drafted\\))?$",
      "description": "A role record's key, never a name"
    },
    "decision": { "type": "string", "minLength": 10 },
    "reason": { "type": "string", "minLength": 10, "description": "Why, in the decider's words if you have them; 'not stated' is an honest value" },
    "scope": { "type": "string", "description": "What it applies to: every app, one campus, one job" },
    "would_reopen": { "type": "string", "description": "The condition under which this should be reconsidered" },
    "rule": {
      "type": "string",
      "description": "Optional: a machine-checkable form of the decision (a validator rule name, a test, a scheduler predicate) when one exists somewhere. Constraints as code, next to the prose."
    },
    "applies_to": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(process|role|app|job|base|vendor|decision):[a-z0-9-]+$" }
    },
    "superseded_by": { "type": ["string", "null"], "pattern": "^decision:" },
    "source": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "confidence": { "type": "string", "enum": ["seen-once", "recurring", "stated-by-owner", "verified"] }
  }
}
